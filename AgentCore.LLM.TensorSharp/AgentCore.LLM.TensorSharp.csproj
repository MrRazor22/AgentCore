<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AssemblyName>AgentCore.LLM.TensorSharp</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Magick.NET-Q8-AnyCPU" Version="14.17.1" />
    <PackageReference Include="MessagePack" Version="3.1.8" />
    <PackageReference Include="TensorSharp.Runtime" Version="3.1.2" />
    <PackageReference Include="TensorSharp.Models" Version="3.1.2" />
    <PackageReference Include="TensorSharp.Backends.GGML" Version="3.1.2" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Native\cuda_kernels\*.ptx">
      <Link>cuda_kernels\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AgentCore\AgentCore.csproj" />
  </ItemGroup>

</Project>
